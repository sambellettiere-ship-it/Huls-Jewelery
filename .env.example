# --- Copy this file to .env for local development and fill in real values ---

# Password Debbie uses to log into the admin panel (/admin). REQUIRED.
# The server will refuse to start if this is not set.
ADMIN_PASSWORD=change-me-to-a-strong-password

# Secret used to sign the login session cookie. REQUIRED in production.
# Use a long random string, e.g. output of: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Your Formspree form ID for the contact/inquiry form.
# The endpoint URL is https://formspree.io/f/XXXXXXXX  ->  the ID is XXXXXXXX
# Debbie's form (https://formspree.io/f/xbglodve) is the built-in default, so
# this only needs setting to point the form at a DIFFERENT Formspree form.
FORMSPREE_FORM_ID=xbglodve

# Where the SQLite database and uploaded images are stored.
# Locally, "data" (a folder in the project) is fine.
# On Railway, mount a persistent volume and set this to its mount path, e.g. /data
DATA_DIR=data

# Set to "production" on Railway so secure cookies are enabled.
NODE_ENV=development

# Port to listen on. Railway sets this automatically; locally defaults to 3000.
# PORT=3000
